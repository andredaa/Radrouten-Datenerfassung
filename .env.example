ENV=development

# Database Settings
POSTGIS_USER=postgres
POSTGIS_PASSWORD=123456
POSTGIS_DB=IMEQ

# Customizable Ports
# Host machine port for Postgres
DB_PORT=5432
# Host machine port for backend
BACKEND_PORT=5000
# Host machine port for frontend
FRONTEND_PORT=80

# Hosts
# Change to web-address if deployed, otherwise localhost
BACKEND_HOST=http://localhost
# change to db if deployed, otherwise localhost
DB_HOST=localhost 


# Formbricks
FORMBRICKS_API_KEY=fbk_